{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nair Video Compressor",
  "version": "0.1.0",
  "identifier": "com.nair.videocompressor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NAIR / VIDEO COMPRESSOR",
        "width": 1080,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
